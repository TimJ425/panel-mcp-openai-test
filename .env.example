# Copy to .env (scripts/setup.sh does this). All services + the notebook read it.

# --- OpenAI-compatible gateway (API keys + model allow-list in front of Ollama) ---
GATEWAY_PORT=8000
GATEWAY_API_KEYS=sk-test-123,sk-test-456      # comma-separated keys the gateway accepts
ALLOWED_MODELS=qwen2.5:3b,qwen2.5:1.5b,llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=4096       # context window ollama gives every model
MODEL_CONTEXT=4096               # what the gateway reports in /v1/models (keep equal)
GATEWAY_ENFORCE_CONTEXT=true     # 400 on over-long prompts (like vLLM) instead of silent truncation

# What the notebook uses to talk to the gateway
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=sk-test-123

# --- Ticket micro service (HTTPS + Basic auth) ---
MICRO_PORT=8443
MICRO_URL=https://localhost:8443
MICRO_EXPECTED_USERNAME=testuser
MICRO_EXPECTED_PASSWORD=testpass

# Credentials the notebook passes to the MCP server
PROXY_USERNAME=testuser
PROXY_PASSWORD=testpass
PROXY_CERT=certs/ca.pem          # CA bundle used to verify the service's TLS cert (relative = project root)
PROXY_VERIFY=true                # true -> verify with PROXY_CERT, false -> no TLS verification

# --- Panel app ---
PANEL_PORT=5006
PANEL_WS_ORIGINS=localhost:8888,127.0.0.1:8888,localhost:5006,127.0.0.1:5006
